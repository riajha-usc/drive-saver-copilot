# Optional. Without a key the agent narrates with its deterministic template and
# every number stays identical, so the prototype runs fully offline.
ANTHROPIC_API_KEY=
DSC_LLM_MODEL=claude-sonnet-5

# Serving. PORT is injected by most platforms; set it only for local runs.
PORT=8000
# Comma separated. Set this to the dashboard's real origin before going live.
DSC_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
# Seed the bundled AI4I sample at startup. Set to 0 to serve uploads only.
DSC_SEED_SAMPLE=1

# Cost model behind the savings figure on the recommendation card.
DSC_UNPLANNED_DOWNTIME_HOURS=8
DSC_DOWNTIME_COST_PER_HOUR=1800
DSC_EMERGENCY_CALLOUT_COST=2500
DSC_PRODUCTION_VALUE_PER_HOUR=950
